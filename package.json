{
	"name": "kitchen-forge",
	"version": "1.1.0",
	"description": "Interactive recipe blocks for Obsidian. Describe ingredients in YAML, then scale the whole recipe with one click or recompute dependent quantities live from formulas.",
	"main": "main.js",
	"type": "module",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"version": "node version-bump.mjs && git add manifest.json versions.json",
		"lint": "eslint . && npm run lint:css",
		"lint:css": "stylelint \"styles.css\"",
		"test": "vitest run",
		"test:watch": "vitest"
	},
	"keywords": [],
	"license": "MIT",
	"devDependencies": {
		"@eslint/js": "9.30.1",
		"@types/node": "^20.0.0",
		"esbuild": "^0.28.0",
		"eslint-plugin-obsidianmd": "0.1.9",
		"globals": "14.0.0",
		"happy-dom": "^20.9.0",
		"jiti": "2.6.1",
		"stylelint": "^17.16.0",
		"stylelint-config-obsidianmd": "^0.1.0",
		"tslib": "2.4.0",
		"typescript": "^5.8.3",
		"typescript-eslint": "8.35.1",
		"vitest": "^4.1.7"
	},
	"dependencies": {
		"jsep": "^1.4.0",
		"obsidian": "latest",
		"yaml": "^2.9.0"
	},
	"overrides": {
		"moment": "^2.31.0"
	}
}
